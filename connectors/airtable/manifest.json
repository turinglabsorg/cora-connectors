{
  "manifestVersion": 1,
  "id": "airtable",
  "version": "0.1.0",
  "authentication": "bearer-token",
  "tools": {
    "list_bases": "read",
    "search_bases": "read",
    "list_records_for_table": "read",
    "search_records": "read",
    "get_table_schema": "read",
    "list_tables_for_base": "read",
    "create_records_for_table": "write",
    "update_records_for_table": "write",
    "delete_records_for_table": "write"
  },
  "resources": "token-scoped Airtable bases",
  "permissions": {
    "read": true,
    "write": true,
    "send": false
  },
  "externalDataTrust": "untrusted"
}
